[Variables]
; User-facing state. The Settings skin writes changes here.
TimeMode=24H
HourFormat=%H
PeriodHidden=1
SecondsHidden=0
SecondsState=On
Scale=1.0
ScaleLabel=100%
Opacity=255
OpacityLabel=100%
ThemeName=White

; Typography
; Segoe UI Light is a Windows system font, so the public project has no font dependency.
FontFace=Segoe UI Light

; Theme colors
PrimaryColor=255,255,255,255
SecondaryColor=205,205,205,225
MutedColor=165,165,165,210
DividerColor=205,205,205,150
